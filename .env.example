# The Office - local development environment
# Copy to .env and fill in. NEVER commit .env.
#
# WHO READS .env - and who does not. An exported variable always wins over this file.
#
#   python -m broker ...        loaded at startup (broker/env.py), names not already set
#   python -m generators ...    loaded at startup (broker/env.py), names not already set
#   scripts/*.sh                sourced (bootstrap, dev-up, console-smoke, deploy, backup)
#   broker/config.py Settings   its own fields only (OFFICE_APP_DSN, ...), from the CWD's .env
#
#   pytest                      NOT loaded - export these or set OFFICE_TEST_* in the shell.
#                               Deliberate: the suite empties the database its DSN names.
#   uvicorn run directly        NOT loaded - use `python -m broker serve`
#   scripts/*.py                NOT loaded - export first (set -a; . ./.env; set +a)
#
# Anything that reads os.environ directly sees only what one of the above put there:
# VILLAGE_BASE_URL, every env:// credential ref (CRE_FORGE_TOKEN, ...), VAULT_*.

# Superuser connection, used only to bootstrap roles and run migrations.
OFFICE_ADMIN_DSN=postgresql://postgres:YOUR_POSTGRES_PASSWORD_HERE@127.0.0.1:5432/theoffice

# Runtime connection. This role cannot UPDATE or DELETE ledger rows.
OFFICE_APP_DSN=postgresql://office_app:YOUR_OFFICE_APP_PASSWORD_HERE@127.0.0.1:5432/theoffice

# Password assigned to the office_app role at bootstrap.
OFFICE_APP_PASSWORD=YOUR_OFFICE_APP_PASSWORD_HERE

# The test suite's own database. STRONGLY recommended.
#
# The suite empties office_human, the Forge registry and every venture-scoped table -
# correct, because a suite that left rows behind would be one whose next run depended on
# its last. Pointed at the development database it also kills any console session you
# have open, every time you run the tests.
#
# `./scripts/bootstrap.sh` creates and migrates this database. Without these set the
# suite falls back to the development pair and says so at startup.
OFFICE_TEST_ADMIN_DSN=postgresql://postgres:YOUR_POSTGRES_PASSWORD_HERE@127.0.0.1:5432/theoffice_test
OFFICE_TEST_APP_DSN=postgresql://office_app:YOUR_OFFICE_APP_PASSWORD_HERE@127.0.0.1:5432/theoffice_test

# Vault - Phase 0.3. Stores credential REFS, never values.
VAULT_ADDR=https://YOUR_VAULT_HOST_HERE:8200
VAULT_TOKEN=YOUR_VAULT_TOKEN_HERE

# Test-only. The stub Forge is in-process and this value is never a real secret;
# it exists so the env-backed credential resolver has something to resolve.
STUB_FORGE_TOKEN=stub-forge-test-token

# Tenant credential presented to CRE Forge on every brokered call. Stored by ref in
# forge_tenant_credential (env://CRE_FORGE_TOKEN) so the value never reaches an agent.
CRE_FORGE_TOKEN=YOUR_CRE_FORGE_TOKEN_HERE

# SimForge tenant credential. forge_tenant_credential.credential_ref is env://SIMFORGE_TOKEN,
# and the same value is OFFICE_TENANT_TOKEN in simforge/.env.
SIMFORGE_TOKEN=

# The Village. SET THIS EXPLICITLY - broker/village.py defaults to
# http://127.0.0.1:8002 when it is unset, and an unset default silently points at
# whatever holds that port. On 4 September 2026 that was an unrelated project's
# container, whose 401 The Office reported as the Village refusing a credential for a
# week. The client now refuses to accept a responder that does not identify as the
# Village, but a written address is what stops it pointing at the wrong one.
# The port is machine-specific: 8002 is the Village's own default and on the
# development machine it belongs to another project. Check it against
# docs/port-allocation.md and the four checks there before using either value.
VILLAGE_BASE_URL=http://127.0.0.1:8120

# Read by scripts/dev-all.sh to ask /api/version which build a live API is running.
# WITHOUT IT THE STALE-BUILD CHECK CANNOT RUN, and dev-all.sh reports the API as
# UNVERIFIED rather than healthy - a check that could not run is not a check that
# passed. On 17 September 2026 an API started the previous evening drove a
# provisioning run on pre-merge code for an afternoon, and this was why nothing said
# so. Any signed-in role can read /api/version; a dedicated low-privilege account is
# the right thing to point this at.
OFFICE_OPERATOR_TOKEN=
