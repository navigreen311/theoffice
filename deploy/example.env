# Copy to deploy/staging.env or deploy/production.env and fill in.
# NEVER commit either of those - .gitignore excludes deploy/*.env.
#
# Every value here is a placeholder. Nothing in this file is a real credential.

# The domain Caddy obtains a certificate for. Must resolve to this VM before the first
# deploy, or certificate issuance fails and the site serves on HTTP only - at which
# point the `secure` session cookie is never sent and the console appears to accept a
# sign-in and then behave as though nobody signed in.
OFFICE_DOMAIN=YOUR_DOMAIN_HERE

# Postgres. The database is not published to the host; these are used inside the
# compose network only.
POSTGRES_DB=theoffice
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE

# The runtime DSN. `office_app` cannot UPDATE or DELETE ledger rows, cannot read a
# persona body, and cannot rewrite history. The API runs as this role and nothing else.
OFFICE_APP_DSN=postgresql://office_app:YOUR_OFFICE_APP_PASSWORD_HERE@db:5432/theoffice

# Migrations only. Used by `scripts/deploy.sh` for the alembic step and by nothing at
# runtime - the API never holds these.
OFFICE_ADMIN_DSN=postgresql://postgres:YOUR_POSTGRES_PASSWORD_HERE@db:5432/theoffice
OFFICE_APP_PASSWORD=YOUR_OFFICE_APP_PASSWORD_HERE

# Credentials. `vault` is the deployed backend; `env` exists for local development only.
# There is deliberately no "vault, falling back to env" mode: a silent fallback is how a
# deployment reads secrets from its own process environment while its config says Vault.
CREDENTIAL_BACKEND=vault
VAULT_ADDR=https://YOUR_VAULT_HOST_HERE:8200
VAULT_TOKEN=YOUR_VAULT_TOKEN_HERE
VAULT_NAMESPACE=

# How often the sweeps run. They are the continuous-verification layer; `broker health`
# reports never_run and stale as unhealthy, so a long interval shows up as a stale
# control rather than as silence.
SWEEP_INTERVAL_SECONDS=3600

BACKUP_RETAIN_DAYS=14
IMAGE_TAG=
